<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ZeusAudioControl.MainWindow" Title="ZEUS Audio Control" Icon="Zeus.ico" Height="800" Width="1060" FontFamily="Segoe UI" FontSize="14" MinHeight="480" MinWidth="650" Background="#101012" Foreground="#F5F5F5" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#B92D40"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="16,11"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderBrush="#444957" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#E34455"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="Opacity" From="0.7" To="1" Duration="0:0:0.12"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Opacity" Value=".75"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value=".35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#261e24"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Margin" Value="0,8,0,8"/>
      <Setter Property="Foreground" Value="#F04455"/>
      <Setter Property="Height" Value="26"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Left" Width="174" Background="#181417" Padding="20">
      <StackPanel>
        <Viewbox Width="54" Height="54" HorizontalAlignment="Left" Margin="0,0,0,12">
          <Canvas Width="64" Height="64">
            <Rectangle Width="64" Height="64" RadiusX="14" RadiusY="14" Fill="#D73939"/>
            <Path Fill="White" Data="M 13,13 H 49 L 29,30 H 43 L 21,53 L 27,39 H 15 L 33,22 H 13 Z"/>
            <Path Stroke="#FFD1D7" StrokeThickness="2" Data="M 51,28 V 36 M 55,25 V 39 M 59,29 V 35"/>
          </Canvas>
        </Viewbox>
        <TextBlock Text="ZEUS AUDIO" FontWeight="Bold" Foreground="#F04444" FontSize="16" Margin="0,0,0,8"/>
        <TextBlock Text="CONTROL  /  BETA 0.4" Foreground="#9BA3B6" FontSize="11" Margin="0,0,0,30"/>
        <Button Style="{StaticResource Nav}" Content="{DynamicResource Label0}" Click="Overview_Click" Margin="0,0,0,10"/>
        <Button Style="{StaticResource Nav}" Content="{DynamicResource Label1}" Click="Audio_Click" Margin="0,0,0,10"/>
        <Button Style="{StaticResource Nav}" Content="{DynamicResource Label2}" Click="Microphone_Click" Margin="0,0,0,10"/>
        <Button Style="{StaticResource Nav}" Content="{DynamicResource Label3}" Click="Settings_Click" Margin="0,0,0,10"/>
      </StackPanel>
    </Border>
    <ScrollViewer Name="MainScroll" VerticalScrollBarVisibility="Auto">
      <Grid Margin="24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Name="PageTitle" Text="Visão geral" FontSize="27" FontWeight="Bold"/>
          <TextBlock Text="{DynamicResource Label4}" Foreground="#AFAFB5"/>
        </StackPanel>
        <StackPanel Name="OverviewPanel" Grid.Row="1" Margin="0,22,0,12">
          <Border Background="#261e24" CornerRadius="14" Padding="20" Margin="0,0,0,18">
            <StackPanel>
              <TextBlock Text="{DynamicResource Label5}" FontSize="23" FontWeight="Bold"/>
              <TextBlock Text="{DynamicResource Label6}" Foreground="#AFAFB5" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <TextBlock Name="DeviceStatus" Text="Procurando dispositivos..." TextWrapping="Wrap" Foreground="#E8B4B4"/>
          <Button Content="{DynamicResource Label7}" HorizontalAlignment="Left" Click="Refresh_Click"/>
          <TextBlock Text="{Binding ElementName=VolumeLabel, Path=Text}" Margin="0,18,0,8"/>
          <TextBlock Text="{Binding ElementName=MicLabel, Path=Text}"/>
          <TextBlock Text="{Binding ElementName=PeakDb, Path=Text}"/>
        </StackPanel>
        <Border Name="ControlsCard" Visibility="Collapsed" Grid.Row="2" Background="#1d191d" CornerRadius="12" Padding="22">
          <StackPanel>
            <StackPanel Name="AudioPanel" Visibility="Collapsed">
              <TextBlock Name="AudioHeading" Text="{DynamicResource Label8}" FontSize="20" FontWeight="SemiBold"/>
              <ComboBox Name="OutputDevices" Height="35" DisplayMemberPath="Label" SelectionChanged="OutputDevices_SelectionChanged"/>
              <TextBlock Text="{DynamicResource Label9}" Margin="0,12,0,2"/>
              <Slider Name="BalanceSlider" Minimum="-100" Maximum="100" Value="0" ValueChanged="Balance_Changed"/>
              <TextBlock Name="BalanceStatus" Text="{DynamicResource Label58}"/>
              <Border Background="#282026" CornerRadius="12" Padding="16" Margin="0,12">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Label10}" FontSize="19" FontWeight="Bold"/>
                  <TextBlock Text="{DynamicResource Label11}" TextWrapping="Wrap"/>
                  <StackPanel Name="AdvancedAudio">
                    <UniformGrid Name="EqGrid" Columns="10" Margin="0,12"/>
                    <TextBlock Text="Bass Boost"/>
                    <Slider Name="BassBoost" Minimum="0" Maximum="9" Value="0"/>
                    <TextBlock Text="{DynamicResource Label12}"/>
                    <Slider Name="LowTone" Minimum="-9" Maximum="9"/>
                    <TextBlock Text="{DynamicResource Label13}"/>
                    <Slider Name="MidTone" Minimum="-9" Maximum="9"/>
                    <TextBlock Text="{DynamicResource Label14}"/>
                    <Slider Name="HighTone" Minimum="-9" Maximum="9"/>
                  </StackPanel>
                  <WrapPanel>
                    <Button Content="{DynamicResource Label15}" Tag="custom" Click="EqPreset_Click"/>
                    <Button Content="Gaming" Tag="game" Click="EqPreset_Click"/>
                    <Button Content="{DynamicResource Label16}" Tag="music" Click="EqPreset_Click"/>
                    <Button Content="{DynamicResource Label17}" Tag="movie" Click="EqPreset_Click"/>
                    <Button Content="Flat" Tag="flat" Click="EqPreset_Click"/>
                  </WrapPanel>
                  <WrapPanel>
                    <Button Content="{DynamicResource Label18}" Click="EqPlay_Click"/>
                    <Button Content="{DynamicResource Label19}" Click="EqStop_Click"/>
                  </WrapPanel>
                  <TextBlock Name="EqStatus" TextWrapping="Wrap"/>
                  <TextBlock Name="SurroundStatus" Text="Surround 7.1: depende do dispositivo e do driver; não emulado pelo ZEUS." TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <WrapPanel>
                <Button Name="StereoLeft" Content="{DynamicResource Label20}" Tag="0" Click="Stereo_Click"/>
                <Button Name="StereoRight" Content="{DynamicResource Label21}" Tag="1" Click="Stereo_Click"/>
              </WrapPanel>
              <TextBlock Text="{DynamicResource Label22}" Margin="0,12,0,2"/>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="{DynamicResource Label23}" Click="Alias_Click" Tag="out"/>
                <TextBox Name="OutputAlias" Margin="0,0,8,8" Padding="8"/>
              </DockPanel>
              <TextBlock Text="{DynamicResource Label24}" Margin="0,20,0,2"/>
              <Slider Name="VolumeSlider" Minimum="0" Maximum="100" TickFrequency="5" ValueChanged="VolumeSlider_ValueChanged"/>
              <TextBlock Name="VolumeLabel" Text="—"/>
              <CheckBox Foreground="White" Name="MuteToggle" Content="{DynamicResource Label25}" Checked="MuteToggle_Changed" Unchecked="MuteToggle_Changed" Margin="0,8,0,18"/>
            </StackPanel>
            <StackPanel Name="MicPanel" Visibility="Collapsed">
              <TextBlock Name="MicHeading" Text="{DynamicResource Label26}" FontSize="18" FontWeight="SemiBold"/>
              <ComboBox Name="InputDevices" Height="35" DisplayMemberPath="Label" SelectionChanged="InputDevices_SelectionChanged"/>
              <TextBlock Text="{DynamicResource Label27}" Margin="0,12,0,2"/>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="{DynamicResource Label23}" Click="Alias_Click" Tag="in"/>
                <TextBox Name="InputAlias" Margin="0,0,8,8" Padding="8"/>
              </DockPanel>
              <TextBlock Text="{DynamicResource Label28}" Margin="0,15,0,2"/>
              <Slider Name="MicSlider" Minimum="0" Maximum="100" ValueChanged="MicSlider_ValueChanged"/>
              <TextBlock Name="MicLabel" Text="—"/>
              <CheckBox Foreground="White" Name="MicMute" Content="{DynamicResource Label29}" Checked="MicMute_Changed" Unchecked="MicMute_Changed" Margin="0,8,0,8"/>
              <TextBlock Text="{DynamicResource Label30}"/>
              <ProgressBar Name="MicMeter" Minimum="0" Maximum="100" Height="12" Foreground="#D73939"/>
              <TextBlock Name="PeakDb" Text="Pico: — dBFS" Margin="0,6,0,8"/>
              <Border Background="#110e11" CornerRadius="8" Margin="0,4,0,12">
                <Canvas Name="WaveCanvas" Height="64" ClipToBounds="True">
                  <Polyline Name="WaveLine" Stroke="#F04455" StrokeThickness="1.5"/>
                </Canvas>
              </Border>
              <TextBlock Text="{DynamicResource Label31}" TextWrapping="Wrap"/>
              <Slider Name="TestGain" Minimum="0" Maximum="24" TickFrequency="3" IsSnapToTickEnabled="True" Value="6"/>
              <TextBlock Text="{Binding ElementName=TestGain, Path=Value, StringFormat={}{0:0} dB}"/>
              <TextBlock Text="{DynamicResource Label32}" FontSize="18" Margin="0,18,0,8"/>
              <WrapPanel Margin="0,0,0,10">
                <Button Content="Studio" Tag="studio" Click="Preset_Click"/>
                <Button Content="{DynamicResource Label33}" Tag="discord" Click="Preset_Click"/>
                <Button Content="{DynamicResource Label34}" Tag="record" Click="Preset_Click"/>
                <Button Content="{DynamicResource Label35}" Click="SaveStudio_Click"/>
              </WrapPanel>
              <TextBlock Name="StudioStatus" TextWrapping="Wrap"/>
              <CheckBox Name="StudioEnabled" Content="{DynamicResource Label36}" Foreground="White" IsChecked="True" Margin="0,4"/>
              <StackPanel Name="AdvancedMic">
                <CheckBox Name="HighPass" Content="{DynamicResource Label37}" Foreground="White" IsChecked="True" Margin="0,4"/>
                <TextBlock Text="{DynamicResource Label38}" Margin="0,10,0,2"/>
                <Slider Name="NoiseReduction" Minimum="0" Maximum="100" Value="0" TickFrequency="5"/>
                <TextBlock Text="{Binding ElementName=NoiseReduction, Path=Value, StringFormat={}{0:0}%}"/>
                <TextBlock Text="{DynamicResource Label39}" TextWrapping="Wrap" Foreground="#AFAFB5"/>
                <CheckBox Name="GateEnabled" Content="{DynamicResource Label40}" Foreground="White" IsChecked="True" Margin="0,4"/>
                <TextBlock Text="{DynamicResource Label41}"/>
                <Slider Name="GateThreshold" Minimum="-65" Maximum="-20" Value="-45"/>
                <TextBlock Text="{Binding ElementName=GateThreshold, Path=Value, StringFormat={}{0:0} dBFS}"/>
                <CheckBox Name="CompressorEnabled" Content="{DynamicResource Label42}" Foreground="White" IsChecked="True" Margin="0,4"/>
                <TextBlock Text="{DynamicResource Label43}"/>
                <Slider Name="Presence" Minimum="-6" Maximum="6" Value="2"/>
                <TextBlock Text="{Binding ElementName=Presence, Path=Value, StringFormat={}{0:0} dB}"/>
              </StackPanel>
              <TextBlock Text="{DynamicResource Label44}" TextWrapping="Wrap" Foreground="#AFAFB5"/>
              <CheckBox Name="RawPlayback" Content="{DynamicResource Label45}" Foreground="White" Margin="0,12,0,0"/>
              <WrapPanel Margin="0,16,0,0">
                <Button Name="RecordButton" Content="{DynamicResource Label46}" Click="Record_Click"/>
                <Button Name="PlayButton" Content="{DynamicResource Label47}" Click="Play_Click" IsEnabled="False"/>
              </WrapPanel>
              <TextBlock Name="TestStatus" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
            <StackPanel Name="SettingsPanel" Visibility="Collapsed">
              <CheckBox Name="AdvancedToggle" Content="{DynamicResource Label48}" IsChecked="True" Foreground="White" Click="Preferences_Click" Margin="0,0,0,8"/>
              <CheckBox Name="EnglishToggle" Content="English" Foreground="White" Click="Preferences_Click" Margin="0,0,0,8"/>
              <CheckBox Name="TrayToggle" Content="{DynamicResource Label49}" Foreground="White" IsChecked="True" Margin="0,0,0,12"/>
              <TextBlock Name="Performance" Text="{DynamicResource Label57}" TextWrapping="Wrap"/>
              <CheckBox Name="AutoStart" Content="{DynamicResource Label50}" Foreground="White" Click="AutoStart_Click" Margin="0,8"/>
              <WrapPanel>
                <Button Content="{DynamicResource Label51}" Click="Export_Click"/>
                <Button Content="{DynamicResource Label52}" Click="Import_Click"/>
                <Button Content="{DynamicResource Label53}" Click="Reset_Click"/>
                <Button Content="{DynamicResource Label60}" Click="RestoreDefaults_Click"/>
              </WrapPanel>
              <TextBlock Name="SettingsHeading" Text="{DynamicResource Label54}" FontSize="18" Margin="0,20,0,8"/>
              <Button Content="{DynamicResource Label55}" Click="Save_Click" HorizontalAlignment="Left"/>
              <TextBlock Text="{DynamicResource Label56}" Foreground="#AFAFB5" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <TextBlock Grid.Row="3" Name="Footer" Margin="0,14,0,0" Foreground="#AFAFB5" Text="{DynamicResource Label59}" TextWrapping="Wrap"/>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>

<Window x:Class="ZeusAudioControl.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ZEUS Audio Control" Icon="Zeus.ico" Height="800" Width="1060" FontFamily="Segoe UI" FontSize="14" MinHeight="480" MinWidth="620" Background="#101218" Foreground="#F5F5F5" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Background" Value="#B92D40"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="16,11"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderBrush="#444957" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E34455"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#242936"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style>
<Style TargetType="Slider"><Setter Property="Margin" Value="0,8,0,8"/><Setter Property="Foreground" Value="#F04455"/><Setter Property="Height" Value="26"/></Style>
    <Style TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,8"/></Style>
  </Window.Resources>
  <DockPanel><Border DockPanel.Dock="Left" Width="210" Background="#171A23" Padding="20"><StackPanel><Viewbox Width="54" Height="54" HorizontalAlignment="Left" Margin="0,0,0,12"><Canvas Width="64" Height="64"><Rectangle Width="64" Height="64" RadiusX="14" RadiusY="14" Fill="#D73939"/><Path Fill="White" Data="M 15,15 L 49,15 L 49,23 L 28,43 L 49,43 L 49,50 L 15,50 L 15,42 L 36,22 L 15,22 Z"/></Canvas></Viewbox><TextBlock Text="ZEUS AUDIO" FontWeight="Bold" Foreground="#F04444" FontSize="16" Margin="0,0,0,8"/><TextBlock Text="CONTROL  /  BETA 0.4" Foreground="#9BA3B6" FontSize="11" Margin="0,0,0,30"/><Button Style="{StaticResource Nav}" Content="Visão geral" Click="Overview_Click" Margin="0,0,0,10"/><Button Style="{StaticResource Nav}" Content="Áudio" Click="Audio_Click" Margin="0,0,0,10"/><Button Style="{StaticResource Nav}" Content="Microfone" Click="Microphone_Click" Margin="0,0,0,10"/><Button Style="{StaticResource Nav}" Content="Configurações" Click="Settings_Click" Margin="0,0,0,10"/></StackPanel></Border><ScrollViewer Name="MainScroll" VerticalScrollBarVisibility="Auto"><Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Name="PageTitle" Text="Visão geral" FontSize="27" FontWeight="Bold"/>
      <TextBlock Text="Central universal de áudio  •  Windows  •  Beta" Foreground="#AFAFB5"/>
    </StackPanel>
    <StackPanel Name="OverviewPanel" Grid.Row="1" Margin="0,22,0,12"><Border Background="#242936" CornerRadius="14" Padding="20" Margin="0,0,0,18"><StackPanel><TextBlock Text="SEU ÁUDIO. SEU CONTROLE." FontSize="23" FontWeight="Bold"/><TextBlock Text="Controles nativos do Windows e laboratório de voz local." Foreground="#AFAFB5" TextWrapping="Wrap"/></StackPanel></Border>
      <TextBlock Text="DISPOSITIVOS ATIVOS" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Name="DeviceStatus" Text="Procurando dispositivos..." TextWrapping="Wrap" Foreground="#E8B4B4"/>
      <Button Content="Atualizar dispositivos" HorizontalAlignment="Left" Click="Refresh_Click"/><TextBlock Text="{Binding ElementName=VolumeLabel, Path=Text, StringFormat=Volume de saída: {0}}" Margin="0,18,0,8"/><TextBlock Text="{Binding ElementName=MicLabel, Path=Text, StringFormat=Volume do microfone: {0}}"/><TextBlock Text="{Binding ElementName=PeakDb, Path=Text}"/>
    </StackPanel>
    <Border Name="ControlsCard" Visibility="Collapsed" Grid.Row="2" Background="#1D2029" CornerRadius="12" Padding="22">
      <StackPanel>
        <StackPanel Name="AudioPanel" Visibility="Collapsed"><TextBlock Name="AudioHeading" Text="Áudio de saída" FontSize="20" FontWeight="SemiBold"/>
        <ComboBox Name="OutputDevices" Height="35" DisplayMemberPath="FriendlyName" SelectionChanged="OutputDevices_SelectionChanged"/>
        <TextBlock Text="Balanço estéreo (quando suportado)" Margin="0,12,0,2"/><Slider Name="BalanceSlider" Minimum="-100" Maximum="100" Value="0" ValueChanged="Balance_Changed"/><TextBlock Name="BalanceStatus" Text="Centro"/><Border Background="#252936" CornerRadius="12" Padding="16" Margin="0,12"><StackPanel><TextBlock Text="EQUALIZADOR • laboratório de áudio" FontSize="19" FontWeight="Bold"/><TextBlock Text="Ajustes aplicados à reprodução de arquivos dentro do ZEUS, não ao áudio global." TextWrapping="Wrap"/><UniformGrid Name="EqGrid" Columns="10" Margin="0,12"/><TextBlock Text="Bass Boost"/><Slider Name="BassBoost" Minimum="0" Maximum="9" Value="0"/><WrapPanel><Button Content="Flat" Tag="flat" Click="EqPreset_Click"/><Button Content="Gaming" Tag="game" Click="EqPreset_Click"/><Button Content="Música" Tag="music" Click="EqPreset_Click"/><Button Content="Filmes" Tag="movie" Click="EqPreset_Click"/></WrapPanel><WrapPanel><Button Content="Abrir áudio e testar" Click="EqPlay_Click"/><Button Content="Parar" Click="EqStop_Click"/></WrapPanel><TextBlock Name="EqStatus" TextWrapping="Wrap"/><TextBlock Text="Surround 7.1: depende do dispositivo e do driver; não emulado pelo ZEUS." TextWrapping="Wrap"/></StackPanel></Border><WrapPanel><Button Content="Testar esquerda" Tag="0" Click="Stereo_Click"/><Button Content="Testar direita" Tag="1" Click="Stereo_Click"/></WrapPanel><TextBlock Text="Apelido da saída" Margin="0,12,0,2"/><DockPanel><Button DockPanel.Dock="Right" Content="Salvar" Click="Alias_Click" Tag="out"/><TextBox Name="OutputAlias" Margin="0,0,8,8" Padding="8"/></DockPanel><TextBlock Text="Volume de saída" Margin="0,20,0,2"/>
        <Slider Name="VolumeSlider" Minimum="0" Maximum="100" TickFrequency="5" ValueChanged="VolumeSlider_ValueChanged"/>
        <TextBlock Name="VolumeLabel" Text="—"/>
        <CheckBox Foreground="White" Name="MuteToggle" Content="Silenciar saída" Checked="MuteToggle_Changed" Unchecked="MuteToggle_Changed" Margin="0,8,0,18"/>
        </StackPanel><StackPanel Name="MicPanel" Visibility="Collapsed"><TextBlock Name="MicHeading" Text="Microfone de entrada" FontSize="18" FontWeight="SemiBold"/>
        <ComboBox Name="InputDevices" Height="35" DisplayMemberPath="FriendlyName" SelectionChanged="InputDevices_SelectionChanged"/>
        <TextBlock Text="Apelido do microfone" Margin="0,12,0,2"/><DockPanel><Button DockPanel.Dock="Right" Content="Salvar" Click="Alias_Click" Tag="in"/><TextBox Name="InputAlias" Margin="0,0,8,8" Padding="8"/></DockPanel><TextBlock Text="Volume do microfone" Margin="0,15,0,2"/>
        <Slider Name="MicSlider" Minimum="0" Maximum="100" ValueChanged="MicSlider_ValueChanged"/>
        <TextBlock Name="MicLabel" Text="—"/><CheckBox Foreground="White" Name="MicMute" Content="Silenciar microfone" Checked="MicMute_Changed" Unchecked="MicMute_Changed" Margin="0,8,0,8"/><TextBlock Text="Intensidade do microfone"/><ProgressBar Name="MicMeter" Minimum="0" Maximum="100" Height="12" Foreground="#D73939"/><TextBlock Name="PeakDb" Text="Pico: — dBFS" Margin="0,6,0,8"/><TextBlock Text="Ganho digital para ouvir o teste (não altera Discord ou OBS)" TextWrapping="Wrap"/><Slider Name="TestGain" Minimum="0" Maximum="24" TickFrequency="3" IsSnapToTickEnabled="True" Value="6"/><TextBlock Text="{Binding ElementName=TestGain, Path=Value, StringFormat={}{0:0} dB}"/>
      <TextBlock Text="VOICE STUDIO  /  TESTE LOCAL" FontSize="18" Margin="0,18,0,8"/>
<WrapPanel Margin="0,0,0,10"><Button Content="Studio" Tag="studio" Click="Preset_Click"/><Button Content="Comunicação" Tag="discord" Click="Preset_Click"/><Button Content="Gravação" Tag="record" Click="Preset_Click"/><Button Content="Salvar perfil" Click="SaveStudio_Click"/></WrapPanel><TextBlock Name="StudioStatus" TextWrapping="Wrap"/>
<CheckBox Name="StudioEnabled" Content="Ativar efeitos Studio" Foreground="White" IsChecked="True" Margin="0,4"/>
<CheckBox Name="HighPass" Content="Filtro de graves (80 Hz)" Foreground="White" IsChecked="True" Margin="0,4"/>
<TextBlock Text="Supressão de ruído adaptativa (local)" Margin="0,10,0,2"/><Slider Name="NoiseReduction" Minimum="0" Maximum="100" Value="0" TickFrequency="5"/><TextBlock Text="{Binding ElementName=NoiseReduction, Path=Value, StringFormat={}{0:0}%}"/><TextBlock Text="Atenua ruído de fundo baixo; não separa vozes simultâneas. Apenas no teste local." TextWrapping="Wrap" Foreground="#AFAFB5"/><CheckBox Name="GateEnabled" Content="Noise Gate (reduz sons baixos)" Foreground="White" IsChecked="True" Margin="0,4"/>
<TextBlock Text="Limiar do gate (dBFS)"/><Slider Name="GateThreshold" Minimum="-65" Maximum="-20" Value="-45"/><TextBlock Text="{Binding ElementName=GateThreshold, Path=Value, StringFormat={}{0:0} dBFS}"/>
<CheckBox Name="CompressorEnabled" Content="Compressor de voz" Foreground="White" IsChecked="True" Margin="0,4"/>
<TextBlock Text="Presença da voz (dB)"/><Slider Name="Presence" Minimum="-6" Maximum="6" Value="2"/><TextBlock Text="{Binding ElementName=Presence, Path=Value, StringFormat={}{0:0} dB}"/>
<TextBlock Text="Desative Studio para comparar com o teste anterior. Efeitos aplicados ao clicar em Ouvir teste; não alteram outros aplicativos." TextWrapping="Wrap" Foreground="#AFAFB5"/>
<CheckBox Name="RawPlayback" Content="Comparar: ouvir áudio original (sem efeitos)" Foreground="White" Margin="0,12,0,0"/><WrapPanel Margin="0,16,0,0"><Button Name="RecordButton" Content="Gravar teste (5 s)" Click="Record_Click"/><Button Name="PlayButton" Content="Ouvir teste" Click="Play_Click" IsEnabled="False"/></WrapPanel><TextBlock Name="TestStatus" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel><StackPanel Name="SettingsPanel" Visibility="Collapsed"><CheckBox Name="TrayToggle" Content="Minimizar para a bandeja do Windows" Foreground="White" IsChecked="True" Margin="0,0,0,12"/><TextBlock Name="Performance" Text="Desempenho" TextWrapping="Wrap"/><CheckBox Name="AutoStart" Content="Iniciar com Windows" Foreground="White" Click="AutoStart_Click" Margin="0,8"/><WrapPanel><Button Content="Exportar perfil" Click="Export_Click"/><Button Content="Importar perfil" Click="Import_Click"/><Button Content="Restaurar perfil de voz" Click="Reset_Click"/></WrapPanel><TextBlock Name="SettingsHeading" Text="Configurações locais" FontSize="18" Margin="0,20,0,8"/><Button Content="Salvar seleção de dispositivos" Click="Save_Click" HorizontalAlignment="Left"/><TextBlock Text="Status do motor: efeitos globais ainda indisponíveis. Os filtros de voz atuam apenas no teste local." Foreground="#AFAFB5" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></StackPanel>
    </Border>
    <TextBlock Grid.Row="3" Name="Footer" Margin="0,14,0,0" Foreground="#AFAFB5" Text="Controles via Windows Core Audio. Sem alterações no driver ou firmware." TextWrapping="Wrap"/>
  </Grid></ScrollViewer></DockPanel>
</Window>
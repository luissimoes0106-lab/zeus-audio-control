<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:zeus="clr-namespace:ZeusAudioControl" x:Class="ZeusAudioControl.MainWindow" Title="ZEUS Audio Control" Icon="Zeus.ico" Height="800" Width="1160" FontFamily="Segoe UI" FontSize="14" MinHeight="480" MinWidth="610" Background="#101015" Foreground="#F5F5F5" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#B92D40"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderBrush="#444957" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
                <ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></ContentPresenter.Resources>
              </ContentPresenter>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#E34455"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="Opacity" From="0.7" To="1" Duration="0:0:0.12"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Opacity" Value=".75"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value=".35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#261e24"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Margin" Value="0,0,0,5"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    </ResourceDictionary>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Left" Width="142" Background="#17171D" Padding="13">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <Image Name="OfficialLogo" Source="ZEUS-Logo.png" Stretch="Uniform" Width="110" Height="110"
               HorizontalAlignment="Center" Margin="0,0,0,12" AutomationProperties.Name="ZEUS Audio Control"/>
        <Button Style="{StaticResource Nav}" Content="{DynamicResource Label0}" Click="Overview_Click" Margin="0,0,0,10"/>
        <Button Style="{StaticResource Nav}" Content="{DynamicResource Label1}" Click="Audio_Click" Margin="0,0,0,10"/>
        <Button Style="{StaticResource Nav}" Content="{DynamicResource Label2}" Click="Microphone_Click" Margin="0,0,0,10"/>
        <Button Style="{StaticResource Nav}" Content="{DynamicResource RoutesTitle}" Click="Routes_Click" Margin="0,0,0,10"/>
        <Button Style="{StaticResource Nav}" Content="Audio Mixer" Click="MixerPage_Click" Margin="0,0,0,10"/>
        <Button Style="{StaticResource Nav}" Content="{DynamicResource ProfilesNavigation}" Click="ProfilesPage_Click" Margin="0,0,0,10"/>
        <Button Style="{StaticResource Nav}" Content="Smart Voice" Click="SmartVoice_Click" Margin="0,0,0,10"/>
        <Button Style="{StaticResource Nav}" Content="Intelligence Pack" Click="Intelligence_Click" Margin="0,0,0,10"/>
        <Button Style="{StaticResource Nav}" Content="ZEUS Quick Control" Click="QuickControl_Click" Margin="0,0,0,10"/>
        <Button Style="{StaticResource Nav}" Content="{DynamicResource AboutZeus}" Click="AboutZeus_Click" Margin="0,0,0,10"/>
        <Button Style="{StaticResource Nav}" Content="{DynamicResource Label3}" Click="Settings_Click" Margin="0,0,0,10"/>
      </StackPanel>
      </ScrollViewer>
    </Border>
    <ScrollViewer Name="MainScroll" VerticalScrollBarVisibility="Auto">
      <Grid Margin="18" MaxWidth="1140">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Name="PageTitle" Text="Visão geral" FontSize="30" FontWeight="Bold"/>
          <TextBlock Text="{DynamicResource Label4}" Foreground="#AFAFB5"/>
        </StackPanel>

        <StackPanel Name="OverviewPanel" Grid.Row="1" Margin="0,12,0,0">
          <UniformGrid Columns="2">
            <Border Style="{StaticResource Card}" Margin="0,0,6,10">
              <StackPanel>
                <TextBlock Text="{DynamicResource Label8}" FontWeight="SemiBold"/>
                <Grid Width="76" Height="76" HorizontalAlignment="Left" Margin="0,4,0,8">
                  <zeus:LevelRing Value="{Binding ElementName=VolumeSlider, Path=Value}"/>
                  <TextBlock Text="{Binding ElementName=VolumeLabel, Path=Text}" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="{StaticResource Primary}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="52"/>
                </Grid>
                <TextBlock Name="OverviewOutput" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ElementName=SurroundStatus, Path=Text}" Foreground="{StaticResource Secondary}"/>
                <Button Content="{DynamicResource Label1}" Click="Audio_Click" HorizontalAlignment="Left" Margin="0,5,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0,0,10">
              <StackPanel>
                <TextBlock Text="{DynamicResource Label26}" FontWeight="SemiBold"/>
                <Grid Width="76" Height="76" HorizontalAlignment="Left" Margin="0,4,0,8">
                  <zeus:LevelRing Value="{Binding ElementName=MicSlider, Path=Value}"/>
                  <TextBlock Text="{Binding ElementName=MicLabel, Path=Text}" HorizontalAlignment="Center" VerticalAlignment="Center"
                             FontSize="12" MaxWidth="52" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </Grid>
                <TextBlock Name="OverviewInput" FontWeight="SemiBold"/>
                <ProgressBar Value="{Binding ElementName=MicMeter, Path=Value}" Height="5" Margin="0,4" Foreground="{StaticResource Accent}" Background="{StaticResource Surface}"/>
                <TextBlock Text="{Binding ElementName=PeakDb, Path=Text}" Foreground="{StaticResource Secondary}"/>
                <Button Content="{DynamicResource Label2}" Click="Microphone_Click" HorizontalAlignment="Left" Margin="0,5,0,0"/>
              </StackPanel>
            </Border>
          </UniformGrid>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Name="OverviewProfile" FontWeight="SemiBold"/>
              <TextBlock Name="OverviewFilters" Foreground="{StaticResource Secondary}"/>
              <TextBlock Name="DeviceStatus" Foreground="{StaticResource Secondary}"/>
              <TextBlock Text="{Binding ElementName=Performance, Path=Text}" Foreground="{StaticResource Secondary}"/>
              <WrapPanel Margin="0,6,0,0">
                <Button Content="{DynamicResource Label7}" Click="Refresh_Click"/>
                <Button Content="{DynamicResource RoutesTitle}" Click="Routes_Click"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        <Border Name="ControlsCard" Visibility="Collapsed" Grid.Row="2" Style="{StaticResource Card}">
          <StackPanel>
            <StackPanel Name="AudioPanel" Visibility="Collapsed">
              <TextBlock Name="AudioHeading" Text="{DynamicResource Label8}" FontSize="20" FontWeight="SemiBold"/>
              <ComboBox Name="OutputDevices" Height="35" DisplayMemberPath="Label" SelectionChanged="OutputDevices_SelectionChanged"/>
              <TextBlock Text="{DynamicResource Label9}" Margin="0,12,0,2"/>
              <Slider Name="BalanceSlider" Minimum="-100" Maximum="100" Value="0" ValueChanged="Balance_Changed"/>
              <TextBlock Name="BalanceStatus" Text="{DynamicResource Label58}"/>
              <Border Style="{StaticResource Card}" Margin="0,8,0,12">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Label10}" FontSize="19" FontWeight="Bold"/>
                  <TextBlock Text="{DynamicResource Label11}" TextWrapping="Wrap"/>
                  <StackPanel Name="AdvancedAudio">
                    <Canvas Name="EqCurve" Background="#101015" Height="85" ClipToBounds="True" SizeChanged="EqCurve_SizeChanged"
                            MouseLeftButtonDown="EqCurve_MouseDown" MouseMove="EqCurve_MouseMove" MouseLeftButtonUp="EqCurve_MouseUp">
                      <Line Name="EqCenter" Stroke="#393946" StrokeThickness="1"/>
                      <Polyline Name="EqLine" Stroke="{StaticResource Accent}" StrokeThickness="2"/>
                    </Canvas>
                    <UniformGrid Name="EqGrid" Columns="10" Margin="0,12"/>
                    <TextBlock Text="Bass Boost"/>
                    <Slider Name="BassBoost" Minimum="0" Maximum="9" Value="0"/>
                    <TextBlock Text="{DynamicResource Label12}"/>
                    <Slider Name="LowTone" Minimum="-9" Maximum="9"/>
                    <TextBlock Text="{DynamicResource Label13}"/>
                    <Slider Name="MidTone" Minimum="-9" Maximum="9"/>
                    <TextBlock Text="{DynamicResource Label14}"/>
                    <Slider Name="HighTone" Minimum="-9" Maximum="9"/>
                  </StackPanel>
                  <WrapPanel>
                    <Button Content="{DynamicResource Label15}" Tag="custom" Click="EqPreset_Click"/>
                    <Button Content="Gaming" Tag="game" Click="EqPreset_Click"/>
                    <Button Content="Gaming FPS" Tag="fps" Click="EqPreset_Click"/>
                    <Button Content="{DynamicResource GamingImmersiveLabel}" Tag="immersive" Click="EqPreset_Click"/>
                    <Button Content="{DynamicResource Label16}" Tag="music" Click="EqPreset_Click"/>
                    <Button Content="{DynamicResource Label17}" Tag="movie" Click="EqPreset_Click"/>
                    <Button Content="Flat" Tag="flat" Click="EqPreset_Click"/>
                  </WrapPanel>
                  <WrapPanel>
                    <Button Content="{DynamicResource Label18}" Click="EqPlay_Click"/>
                    <Button Content="{DynamicResource Label19}" Click="EqStop_Click"/>
                  </WrapPanel>
                  <CheckBox Name="VirtualSurround" Content="{DynamicResource SurroundLocal}"/>
                  <TextBlock Name="EqStatus" TextWrapping="Wrap"/>
                  <TextBlock Name="SurroundStatus" Text="Surround 7.1: depende do dispositivo e do driver; não emulado pelo ZEUS." TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <WrapPanel Name="ChannelTests">
                <Button Name="StereoLeft" Content="{DynamicResource Label20}" Tag="0" Click="Stereo_Click"/>
                <Button Name="StereoRight" Content="{DynamicResource Label21}" Tag="1" Click="Stereo_Click"/>
              </WrapPanel>
              <TextBlock Text="{DynamicResource Label22}" Margin="0,12,0,2"/>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="{DynamicResource Label23}" Click="Alias_Click" Tag="out"/>
                <TextBox Name="OutputAlias" Margin="0,0,8,8" Padding="8"/>
              </DockPanel>
              <TextBlock Text="{DynamicResource Label24}" Margin="0,20,0,2"/>
              <Slider Name="VolumeSlider" Minimum="0" Maximum="100" TickFrequency="5" ValueChanged="VolumeSlider_ValueChanged"/>
              <TextBlock Name="VolumeLabel" Text="—"/>
              <CheckBox Foreground="White" Name="MuteToggle" Content="{DynamicResource Label25}" Checked="MuteToggle_Changed" Unchecked="MuteToggle_Changed" Margin="0,8,0,18"/>
            </StackPanel>
            <StackPanel Name="MicPanel" Visibility="Collapsed">
              <TextBlock Name="MicHeading" Text="{DynamicResource Label26}" FontSize="18" FontWeight="SemiBold"/>
              <ComboBox Name="InputDevices" Height="35" DisplayMemberPath="Label" SelectionChanged="InputDevices_SelectionChanged"/>
              <TextBlock Text="{DynamicResource Label27}" Margin="0,12,0,2"/>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="{DynamicResource Label23}" Click="Alias_Click" Tag="in"/>
                <TextBox Name="InputAlias" Margin="0,0,8,8" Padding="8"/>
              </DockPanel>
              <TextBlock Text="{DynamicResource Label28}" Margin="0,15,0,2"/>
              <Slider Name="MicSlider" Minimum="0" Maximum="100" ValueChanged="MicSlider_ValueChanged"/>
              <TextBlock Name="MicLabel" Text="—"/>
              <CheckBox Foreground="White" Name="MicMute" Content="{DynamicResource Label29}" Checked="MicMute_Changed" Unchecked="MicMute_Changed" Margin="0,8,0,8"/>
              <TextBlock Text="{DynamicResource Label30}"/>
              <ProgressBar Name="MicMeter" Minimum="0" Maximum="100" Height="12" Foreground="#D73939"/>
              <TextBlock Name="PeakDb" Text="Pico: — dBFS" Margin="0,6,0,8"/>
              <Border Background="#110e11" CornerRadius="8" Margin="0,4,0,12">
                <Canvas Name="WaveCanvas" Height="64" ClipToBounds="True">
                  <Polyline Name="WaveLine" Stroke="#F04455" StrokeThickness="1.5"/>
                </Canvas>
              </Border>
              <TextBlock Text="{DynamicResource Label31}" TextWrapping="Wrap"/>
              <Slider Name="TestGain" Minimum="0" Maximum="24" TickFrequency="3" IsSnapToTickEnabled="True" Value="6"/>
              <Grid Width="66" Height="66" HorizontalAlignment="Left" Margin="0,0,0,5">
                <zeus:LevelRing Value="{Binding ElementName=TestGain, Path=Value, Converter={x:Static zeus:GainToPercent.Instance}}"/>
                <TextBlock Text="{Binding ElementName=TestGain, Path=Value, StringFormat={}{0:0} dB}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock Text="{DynamicResource Label32}" FontSize="18" Margin="0,18,0,8"/>
              <WrapPanel Margin="0,0,0,10">
                <Button Content="Studio" Tag="studio" Click="Preset_Click"/>
                <Button Content="{DynamicResource Label33}" Tag="communication" Click="Preset_Click"/>
                <Button Content="Gaming" Tag="gaming" Click="Preset_Click"/>
                <Button Content="{DynamicResource Label34}" Tag="record" Click="Preset_Click"/>
                <Button Content="{DynamicResource Label35}" Click="SaveStudio_Click"/>
              </WrapPanel>
              <TextBlock Name="StudioStatus" TextWrapping="Wrap"/>
              <CheckBox Name="StudioEnabled" Content="{DynamicResource Label36}" Foreground="White" IsChecked="True" Margin="0,4"/>
              <StackPanel Name="AdvancedMic">
                <CheckBox Name="GamingVoiceAgc" Content="{DynamicResource GamingVoiceAgcLabel}"/>
                <CheckBox Name="VoiceShield" Content="{DynamicResource VoiceShield}"/>
                <CheckBox Name="HighPass" Content="{DynamicResource Label37}" Foreground="White" IsChecked="True" Margin="0,4"/>
                <TextBlock Text="{DynamicResource Label38}" Margin="0,10,0,2"/>
                <Slider Name="NoiseReduction" Minimum="0" Maximum="100" Value="0" TickFrequency="5"/>
                <TextBlock Text="{Binding ElementName=NoiseReduction, Path=Value, StringFormat={}{0:0}%}"/>
                <TextBlock Text="{DynamicResource Label39}" TextWrapping="Wrap" Foreground="#AFAFB5"/>
                <CheckBox Name="GateEnabled" Content="{DynamicResource Label40}" Foreground="White" IsChecked="True" Margin="0,4"/>
                <TextBlock Text="{DynamicResource Label41}"/>
                <Slider Name="GateThreshold" Minimum="-65" Maximum="-20" Value="-45"/>
                <TextBlock Text="{Binding ElementName=GateThreshold, Path=Value, StringFormat={}{0:0} dBFS}"/>
                <TextBlock Text="{DynamicResource Attack}"/>
                <Slider Name="GateAttack" Minimum="1" Maximum="100" Value="5" ToolTip="{DynamicResource Attack}"/>
                <TextBlock Text="{Binding ElementName=GateAttack, Path=Value, StringFormat={}{0:0.0} ms}"/>
                <TextBlock Text="{DynamicResource Hold}"/>
                <Slider Name="GateHold" Minimum="0" Maximum="500" Value="0" ToolTip="{DynamicResource Hold}"/>
                <TextBlock Text="{Binding ElementName=GateHold, Path=Value, StringFormat={}{0:0.0} ms}"/>
                <TextBlock Text="{DynamicResource Release}"/>
                <Slider Name="GateRelease" Minimum="10" Maximum="1000" Value="150" ToolTip="{DynamicResource Release}"/>
                <TextBlock Text="{Binding ElementName=GateRelease, Path=Value, StringFormat={}{0:0.0} ms}"/>
                <CheckBox Name="CompressorEnabled" Content="{DynamicResource Label42}" Foreground="White" IsChecked="True" Margin="0,4"/>
                <TextBlock Text="{DynamicResource CompThreshold}"/>
                <Slider Name="CompressorThreshold" Minimum="-48" Maximum="-3" Value="-18" ToolTip="{DynamicResource CompThreshold}"/>
                <TextBlock Text="{Binding ElementName=CompressorThreshold, Path=Value, StringFormat={}{0:0.0} dBFS}"/>
                <TextBlock Text="{DynamicResource Ratio}"/>
                <Slider Name="CompressorRatio" Minimum="1" Maximum="12" Value="3" ToolTip="{DynamicResource Ratio}"/>
                <TextBlock Text="{Binding ElementName=CompressorRatio, Path=Value, StringFormat={}{0:0.0} :1}"/>
                <TextBlock Text="{DynamicResource VoiceLimiterLabel}"/>
                <Slider Name="VoiceLimiter" Minimum="5" Maximum="35" Value="35"/>
                <TextBlock Text="{Binding ElementName=VoiceLimiter, Path=Value, StringFormat={}{0:0}% FS}"/>
                <TextBlock Text="{DynamicResource Label43}"/>
                <Slider Name="Presence" Minimum="-6" Maximum="6" Value="2"/>
                <TextBlock Text="{Binding ElementName=Presence, Path=Value, StringFormat={}{0:0} dB}"/>
              </StackPanel>
              <TextBlock Text="{DynamicResource Label44}" TextWrapping="Wrap" Foreground="#AFAFB5"/>
              <CheckBox Name="RawPlayback" Content="{DynamicResource Label45}" Foreground="White" Margin="0,12,0,0"/>
              <WrapPanel Margin="0,16,0,0">
                <Button Name="RecordButton" Content="{DynamicResource Label46}" Click="Record_Click"/>
                <Button Name="PlayButton" Content="{DynamicResource Label47}" Click="Play_Click" IsEnabled="False"/>
              </WrapPanel>
              <TextBlock Name="TestStatus" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>

            <StackPanel Name="RoutesPanel" Visibility="Collapsed">
              <TextBlock Text="{DynamicResource RouteAbout}" Foreground="{StaticResource Secondary}"/>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Mode}" FontWeight="SemiBold"/>
                  <ComboBox Name="RouteMode" SelectedIndex="0" SelectionChanged="RouteMode_Changed" Margin="0,0,0,8">
                    <ComboBoxItem Content="{DynamicResource PlaybackRoute}"/>
                    <ComboBoxItem Content="{DynamicResource VoiceRoute}"/>
                    <ComboBoxItem Content="{DynamicResource HeadphoneRoute}"/>
                  </ComboBox>
                  <TextBlock Name="RouteHelp" TextWrapping="Wrap" Foreground="{StaticResource Secondary}"/>
                  <TextBlock Text="{DynamicResource RouteSource}"/>
                  <ComboBox Name="RouteInput" DisplayMemberPath="Label" Margin="0,0,0,8"/>
                  <TextBlock Text="{DynamicResource RouteDestination}"/>
                  <ComboBox Name="RouteOutput" DisplayMemberPath="Label" Margin="0,0,0,8"/>
                  <StackPanel Name="PlaybackOptions">
                    <CheckBox Name="RouteCompressor" Content="{DynamicResource OutputCompressor}"/>
                    <CheckBox Name="RouteNormalizer" Content="{DynamicResource Normalize}"/>
                  </StackPanel>
                  <CheckBox Name="RouteLowLatency" Content="{DynamicResource LowLatency}"/>
                  <CheckBox Name="RouteConfirm"/>
                  <CheckBox Name="MonitorOriginal" Content="{DynamicResource Label45}" Click="MonitorOriginal_Click" Visibility="Collapsed"/>
                  <WrapPanel Margin="0,9,0,0">
                    <Button Name="RouteStart" Content="{DynamicResource StartRoute}" Click="StartRoute_Click"/>
                    <Button Name="RouteStop" Content="{DynamicResource Label19}" Click="StopRoute_Click" IsEnabled="False"/>
                  </WrapPanel>
                  <TextBlock Name="RouteStatus" Foreground="{StaticResource Secondary}"/>
                  <TextBlock Name="RouteMetrics" Foreground="{StaticResource Secondary}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="{DynamicResource MeterTitle}" FontWeight="SemiBold"/>
                  <TextBlock Name="SaturationStatus"/>
                  <Canvas Name="RouteWave" Height="66" Background="#101015" ClipToBounds="True" Margin="0,0,0,8">
                    <Polyline Name="DryWave" Stroke="#9791A9" StrokeThickness="1"/>
                    <Polyline Name="WetWave" Stroke="{StaticResource Accent}" StrokeThickness="1"/>
                  </Canvas>
                  <TextBlock Text="{DynamicResource SpectrumTitle}"/>
                  <Canvas Name="SpectrumCanvas" Height="78" Background="#101015" ClipToBounds="True">
                    <Polyline Name="SpectrumLine" Stroke="{StaticResource Accent}" StrokeThickness="1.5"/>
                  </Canvas>
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel Name="MixerPanel" Visibility="Collapsed"/>
            <StackPanel Name="ProfilesPanel" Visibility="Collapsed"/>
            <StackPanel Name="SmartVoicePanel" Visibility="Collapsed"/>
            <StackPanel Name="SettingsPanel" Visibility="Collapsed">
              <CheckBox Name="AdvancedToggle" Content="{DynamicResource Label48}" IsChecked="True" Foreground="White" Click="Preferences_Click" Margin="0,0,0,8"/>
              <CheckBox Name="EnglishToggle" Content="English" Foreground="White" Click="Preferences_Click" Margin="0,0,0,8"/>
              <CheckBox Name="TrayToggle" Content="{DynamicResource Label49}" Foreground="White" IsChecked="True" Margin="0,0,0,12"/>
              <TextBlock Name="Performance" Text="{DynamicResource Label57}" TextWrapping="Wrap"/>
              <CheckBox Name="AutoStart" Content="{DynamicResource Label50}" Foreground="White" Click="AutoStart_Click" Margin="0,8"/>
              <WrapPanel>
                <Button Content="{DynamicResource Label51}" Click="Export_Click"/>
                <Button Content="{DynamicResource Label52}" Click="Import_Click"/>
                <Button Content="{DynamicResource Label53}" Click="Reset_Click"/>
                <Button Content="{DynamicResource Label60}" Click="RestoreDefaults_Click"/>
              </WrapPanel>
              <TextBlock Name="SettingsHeading" Text="{DynamicResource Label54}" FontSize="18" Margin="0,20,0,8"/>
              <Button Content="{DynamicResource Label55}" Click="Save_Click" HorizontalAlignment="Left"/>
              <TextBlock Text="{DynamicResource Label56}" Foreground="#AFAFB5" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <TextBlock Grid.Row="3" Name="Footer" Margin="0,14,0,0" Foreground="#AFAFB5" Text="{DynamicResource Label59}" TextWrapping="Wrap"/>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>

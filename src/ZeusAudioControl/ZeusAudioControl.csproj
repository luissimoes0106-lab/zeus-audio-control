<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ZeusAudioControl</AssemblyName>
    <Product>ZEUS Audio Control</Product>
    <Description>Independent Windows audio endpoint controls and local microphone testing.</Description>
    <Company>ZEUS Audio Control open-source project</Company>
    <Copyright>ZEUS Audio Control contributors</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
</Project>
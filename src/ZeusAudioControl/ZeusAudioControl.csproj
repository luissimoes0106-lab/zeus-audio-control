<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Zeus.ico</ApplicationIcon>
    <Version>0.7.3-beta</Version>
    <AssemblyName>ZeusAudioControl</AssemblyName>
    <Product>ZEUS Audio Control</Product>
    <Description>Windows audio processing, endpoint routing and microphone monitoring.</Description>
    <Company>ZEUS Audio Control open-source project</Company>
    <Copyright>ZEUS Audio Control contributors</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="Zeus.ico;ZEUS-Logo.png" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
</Project>